      { "data": "data: {\"id\":\"ds-1\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\n", "delayMs": 5 },
      { "data": "data: {\"id\":\"ds-1\",\"choices\":[],\"usage\":{\"prompt_tokens\":30,\"completion_tokens\":10,\"total_tokens\":40}}\n\n", "delayMs": 5 },
