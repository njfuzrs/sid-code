# sid-code build output
/sid-code
/sid-code-go
/dist
.playwright-mcp

# Go (保留作参考)
*.exe
*.test
*.out

# TypeScript / Bun
node_modules/
bun.lockb
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env
.env
*.env

# 会话和配置（用户数据）
.sid-code/sessions/
.sid-code/config.yaml

# 历史对话 dump（含 holdout 元数据风险，禁止入库；F-H2 修复）
chat_session*.json
*.session

# MCP config (contains API keys)
.mcp.json
/.sid-code/tool-results/

# 团队默认配置真实值（含共享 API key，只保留占位模板 team-defaults.template.json 入库）
/scripts/team-defaults.json

# 临时文件
_template
scheduled_tasks.lock

# 构建时下载的预编译 ripgrep 二进制（不入库，按需从服务器拉；见 scripts/fetch-ripgrep.ts）
# 但保留 vendor/rg-embed 的 0 字节占位入库，使未跑 fetch 时 bun build 不因缺文件报错。
/vendor/rg-*
!/vendor/rg-embed