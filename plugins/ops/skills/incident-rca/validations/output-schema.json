{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "incident-rca/output-schema",
  "type": "object",
  "required": ["incident_summary", "severity", "hypotheses", "evidence_chain", "action_plan"],
  "properties": {
    "incident_summary": {
      "type": "object",
      "required": ["title", "severity", "impact_scope", "duration_estimate"],
      "properties": {
        "title": { "type": "string" },
        "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "impact_scope": { "type": "string" },
        "duration_estimate": { "type": "string" },
        "services_affected": { "type": "array", "items": { "type": "string" } }
      }
    },
    "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "hypothesis", "likelihood", "evidence_refs"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "hypothesis": { "type": "string" },
          "likelihood": { "type": "string", "enum": ["high", "medium", "low"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "root_service": { "type": ["string", "null"] }
        }
      },
      "minItems": 1,
      "maxItems": 5
    },
    "evidence_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "type", "source", "content_summary"],
        "properties": {
          "evidence_id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["log", "metric", "trace", "commit", "adr", "config"]
          },
          "source": { "type": "string" },
          "content_summary": { "type": "string" },
          "timestamp": { "type": ["string", "null"] }
        }
      }
    },
    "action_plan": {
      "type": "object",
      "required": ["hotfix", "mitigation", "long_term"],
      "properties": {
        "hotfix": { "type": "array", "items": { "type": "string" } },
        "mitigation": { "type": "array", "items": { "type": "string" } },
        "long_term": { "type": "array", "items": { "type": "string" } }
      }
    },
    "skipped_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
