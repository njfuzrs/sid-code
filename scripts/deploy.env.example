# scripts/deploy.env.example — 发布上传凭据模板
#
# 使用方法：
#   cp scripts/deploy.env.example scripts/deploy.env
#   然后编辑 scripts/deploy.env 填入真实值。
#
# release.sh 启动时会自动 source scripts/deploy.env（该文件已被 .gitignore 忽略，不会入库）。

# SSH 上传目标（必填，只用于 scp/ssh，不会进任何对外 URL；填 IP 或域名都行）
# release.sh / website-deploy.sh 均**不内置默认值**：缺失时直接报错要求配置，
# 而不是悄悄打到某台预设服务器上。
DEPLOY_SSH_HOST='deploy.example.com'

# 对外访问地址（可选，留空用默认 https://www.sid-code.cc —— 这是项目的公开官网，
# 与上面的 SSH 目标是两回事，可以放心留空）。
# ⚠️ 与 DEPLOY_SSH_HOST 是两件事，不要合并成一个：install.sh 的下载地址、冒烟校验、
# ripgrep 下载都由这里派生，必须是带证书的域名 —— 服务器 80 端口整段 301 → https，
# 证书只签了 sid-code.cc，用 IP 走 https 会 TLS 校验失败（curl exit 60），安装链路直接断。
# PUBLIC_BASE_URL='https://www.sid-code.cc'

# SSH 用户
DEPLOY_SSH_USER='root'

# SSH 密码（配置后 release.sh 用 sshpass 免交互上传；留空则回退为交互式输入密码）
DEPLOY_SSH_PASSWORD=''

# 服务器发布目录（可选，留空用 release.sh 默认值 /var/www/html/releases/sid-code）
# DEPLOY_PATH='/var/www/html/releases/sid-code'
