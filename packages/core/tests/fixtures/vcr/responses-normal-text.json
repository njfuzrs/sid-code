{
  "description": "OpenAI Responses API — 正常文本流",
  "provider": "openai-responses",
  "model": "gpt-4o-mini",
  "request": {
    "method": "POST",
    "url": "/v1/responses",
    "body": {
      "model": "gpt-4o-mini",
      "input": "Say hi",
      "stream": true
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "text/event-stream"
    },
    "chunks": [
      { "data": "event: response.created\ndata: {\"type\":\"response.created\",\"response\":{\"id\":\"resp_001\",\"status\":\"in_progress\"},\"sequence_number\":0}\n\n", "delayMs": 0 },
      { "data": "event: response.in_progress\ndata: {\"type\":\"response.in_progress\",\"response\":{\"id\":\"resp_001\",\"status\":\"in_progress\"},\"sequence_number\":1}\n\n", "delayMs": 10 },
      { "data": "event: response.output_item.added\ndata: {\"type\":\"response.output_item.added\",\"output_index\":0,\"item\":{\"id\":\"item_001\",\"type\":\"message\",\"role\":\"assistant\",\"status\":\"in_progress\"},\"sequence_number\":2}\n\n", "delayMs": 10 },
      { "data": "event: response.content_part.added\ndata: {\"type\":\"response.content_part.added\",\"item_id\":\"item_001\",\"output_index\":0,\"content_index\":0,\"part\":{\"type\":\"output_text\",\"text\":\"\"},\"sequence_number\":3}\n\n", "delayMs": 10 },
      { "data": "event: response.output_text.delta\ndata: {\"type\":\"response.output_text.delta\",\"item_id\":\"item_001\",\"output_index\":0,\"content_index\":0,\"delta\":\"Hello\",\"sequence_number\":4}\n\n", "delayMs": 50 },
      { "data": "event: response.output_text.delta\ndata: {\"type\":\"response.output_text.delta\",\"item_id\":\"item_001\",\"output_index\":0,\"content_index\":0,\"delta\":\" there\",\"sequence_number\":5}\n\n", "delayMs": 30 },
      { "data": "event: response.output_text.delta\ndata: {\"type\":\"response.output_text.delta\",\"item_id\":\"item_001\",\"output_index\":0,\"content_index\":0,\"delta\":\"!\",\"sequence_number\":6}\n\n", "delayMs": 20 },
      { "data": "event: response.output_text.done\ndata: {\"type\":\"response.output_text.done\",\"item_id\":\"item_001\",\"output_index\":0,\"content_index\":0,\"text\":\"Hello there!\",\"sequence_number\":7}\n\n", "delayMs": 10 },
      { "data": "event: response.content_part.done\ndata: {\"type\":\"response.content_part.done\",\"item_id\":\"item_001\",\"output_index\":0,\"content_index\":0,\"part\":{\"type\":\"output_text\",\"text\":\"Hello there!\"},\"sequence_number\":8}\n\n", "delayMs": 5 },
      { "data": "event: response.output_item.done\ndata: {\"type\":\"response.output_item.done\",\"output_index\":0,\"item\":{\"id\":\"item_001\",\"type\":\"message\",\"role\":\"assistant\",\"status\":\"completed\"},\"sequence_number\":9}\n\n", "delayMs": 5 },
      { "data": "event: response.completed\ndata: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_001\",\"status\":\"completed\",\"usage\":{\"input_tokens\":8,\"output_tokens\":4,\"total_tokens\":12}},\"sequence_number\":10}\n\n", "delayMs": 5 }
    ]
  }
}
