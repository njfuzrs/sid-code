      "agent": "main",
      "response": {
        "content": [
          {
            "type": "text",
            "text": "先看文件。"
          },
          {
            "type": "tool_use",
            "id": "toolu_01",
            "name": "read",
            "input": {
              "path": "src/config.ts"
            }
          }
        ],
        "stop_reason": "tool_use"
      },
      "usage": {
        "input_tokens": 1200,
        "output_tokens": 40,
        "cache_creation_input_tokens": 8000
      }
    },
    {
      "agent": "main",
      "response": {
        "content": [
          {
            "type": "tool_use",
            "id": "toolu_02",
            "name": "grep",
            "input": {
              "pattern": "30000"
