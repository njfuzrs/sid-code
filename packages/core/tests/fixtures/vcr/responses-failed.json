{
  "description": "OpenAI Responses — response.failed 映射为 error 事件",
  "provider": "openai-responses",
  "scenario": "failed",
  "model": "gpt-5.6-luna",
  "request": {
    "method": "POST",
    "url": "/v1/responses",
    "body": {
      "model": "gpt-5.6-luna",
      "stream": true
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "text/event-stream"
    },
    "chunks": [
      {
        "data": "event: response.created\ndata: {\"type\":\"response.created\",\"response\":{\"id\":\"resp_f\",\"status\":\"in_progress\"},\"sequence_number\":0}\n\n",
        "delayMs": 0
      },
      {
        "data": "event: response.failed\ndata: {\"type\":\"response.failed\",\"response\":{\"id\":\"resp_f\",\"status\":\"failed\"},\"error\":{\"message\":\"The model is overloaded\",\"type\":\"server_error\"},\"sequence_number\":1}\n\n",
        "delayMs": 5
      }
    ]
  }
}
