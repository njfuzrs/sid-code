{
  "name": "sid-code",
  "version": "0.1.600",
  "description": "AI 编程 CLI 工具 (TypeScript + Bun + Ink)",
  "license": "MIT",
  "type": "module",
  "main": "packages/cli/src/entrypoints/bootstrap.ts",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run packages/cli/src/entrypoints/bootstrap.ts",
    "build": "make build",
    "build-bump": "make build-bump",
    "test": "bun test",
    "test:ui": "bun test tests/ui packages/cli/src/ui",
    "test:ui:stats": "bun run scripts/ui-test-stats.ts",
    "website:dev": "bun run --cwd website dev",
    "website:build": "bun run --cwd website build",
    "website:preview": "bun run --cwd website preview",
    "docs:gen-reference": "bun run scripts/docs-gen-reference.ts",
    "docs:gen-reference-check": "bun run scripts/docs-gen-reference.ts --check",
    "docs:gen-reference-stale": "bun run scripts/docs-gen-reference.ts --stale",
    "docs:coverage": "bun run scripts/docs-gen-reference.ts --coverage",
    "docs:coverage-strict": "bun run scripts/docs-gen-reference.ts --coverage-strict",
    "changelog:curate": "bun run scripts/changelog-curate.ts",
    "changelog:check": "bun run scripts/changelog-curate.ts --check",
    "install-hooks": "sh scripts/install-git-hooks.sh",
    "lint": "oxlint packages tests scripts evals website",
    "lint:fix": "oxlint packages tests scripts evals website --fix",
    "lint:boundary": "bun run scripts/pkg-boundary-scan.ts",
    "eval:run": "bun run packages/eval-framework/core/runner.ts",
    "eval:list": "bun run scripts/eval/list-evals.ts",
    "eval:tally": "bun run scripts/eval/tally-baseline.ts",
    "eval:bench": "bun run scripts/eval/run-bench.ts",
    "eval:bench-report": "bun run scripts/eval/bench-report.ts",
    "eval:plan-capability": "bun run scripts/eval/run-plan-capability.ts",
    "eval:memory-capability": "bun run scripts/eval/run-memory-capability.ts",
    "eval:context-capability": "bun run scripts/eval/run-context-capability.ts",
    "eval:router-capability": "bun run scripts/eval/run-router-capability.ts",
    "eval:harness-capability": "bun run scripts/eval/run-harness-capability.ts",
    "eval:dashboard": "bun run scripts/eval/dashboard.ts",
    "eval:dashboard-html": "bun run scripts/eval/build-dashboard-html.ts",
    "eval:dashboard:open": "bun run scripts/eval/build-dashboard-html.ts --serve",
    "eval:lint-arch": "bun run scripts/eval/lint-architecture.ts",
    "eval:diagnose": "bun run scripts/eval/diagnose.ts",
    "eval:verify-diagnosis": "bun run scripts/eval/verify-diagnosis.ts"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@anthropic-ai/sdk": "^0.79.0",
    "@sid-code/cli": "workspace:*",
    "@sid-code/core": "workspace:*",
    "@sid-code/shared": "workspace:*",
    "@sid-code/tui-renderer": "workspace:*",
    "auto-bind": "^5.0.1",
    "bidi-js": "^1.0.3",
    "chalk": "5.6.2",
    "cli-boxes": "3.0.0",
    "cli-highlight": "2.1.11",
    "cli-truncate": "^5.2.0",
    "code-excerpt": "^4.0.0",
    "diff": "^9.0.0",
    "emoji-regex": "^10.6.0",
    "fuse.js": "^7.4.1",
    "get-east-asian-width": "^1.5.0",
    "glob": "^13.0.6",
    "indent-string": "^5.0.0",
    "lodash-es": "^4.17.21",
    "lowlight": "^3.3.0",
    "marked": "^17.0.4",
    "minimatch": "^10.2.4",
    "mnemonist": "0.40.3",
    "react": "^19.2.4",
    "react-devtools-core": "^7.0.1",
    "react-reconciler": "0.33.0",
    "scheduler": "0.27.0",
    "semver": "^7.6.0",
    "signal-exit": "^4.1.0",
    "stack-utils": "^2.0.6",
    "string-width": "^7.0.0",
    "strip-ansi": "^7.2.0",
    "supports-hyperlinks": "3.2.0",
    "tinycolor2": "^1.6.0",
    "tinygradient": "^2.0.1",
    "usehooks-ts": "^3.1.0",
    "wrap-ansi": "^9.0.0",
    "yaml": "^2.8.2",
    "zod": "^3.25.0"
  },
  "overrides": {
    "react-reconciler": "0.33.0",
    "scheduler": "0.27.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/diff": "^8.0.0",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-reconciler": "^0.33.0",
    "@types/semver": "^7.5.8",
    "@types/stack-utils": "^2.0.3",
    "@types/tinycolor2": "^1.4.6",
    "eval-framework": "workspace:*",
    "js-yaml": "^4.1.1",
    "oxlint": "1.77.0",
    "@oxlint/binding-darwin-arm64": "1.77.0",
    "@oxlint/binding-darwin-x64": "1.77.0",
    "@oxlint/binding-linux-arm64-gnu": "1.77.0",
    "@oxlint/binding-linux-x64-gnu": "1.77.0",
    "type-fest": "^5.8.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
